APP_NAME="Koedu CRM"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Makassar
APP_URL=http://localhost:8000
APP_PORT=8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# Log aplikasi ditulis ke folder logs/ (tidak masuk git).
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info

# --- Database (container "db") ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=koedu
DB_USERNAME=koedu
DB_PASSWORD=
DB_FORWARD_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=koedu_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@koedu.test"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- WhatsApp ---
# waha = simulasi self-hosted, cloud_api = WhatsApp Cloud API resmi (Meta).
WHATSAPP_DRIVER=waha
WAHA_URL=http://waha:3000
WAHA_PORT=3000
WAHA_SESSION=default
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=
# Diisi hanya bila WHATSAPP_DRIVER=cloud_api.
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_APP_SECRET=
WA_CLOUD_VERIFY_TOKEN=
WA_CLOUD_API_VERSION=v23.0

# --- AI (ekstraksi jadwal dari chat) ---
# Urutan provider untuk fallback, dipisah koma.
AI_PROVIDERS=gemini
AI_TIMEOUT_SECONDS=20
# Banyak key dipisah koma. Key yang kena limit diistirahatkan sementara, lalu key berikutnya dipakai.
GEMINI_API_KEYS=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_KEY_COOLDOWN_SECONDS=60

# --- Google Sheets (cermin jadwal) ---
GOOGLE_SHEETS_ENABLED=false
GOOGLE_SHEETS_SPREADSHEET_ID=
# Path file JSON service account di dalam container (simpan di storage/app/private, tidak masuk git).
GOOGLE_SHEETS_CREDENTIALS_PATH=/var/www/html/storage/app/private/google-service-account.json

# --- n8n ---
N8N_PORT=5678
N8N_DB_NAME=n8n
N8N_ENCRYPTION_KEY=
# Token yang dipakai n8n saat memanggil API Laravel (header X-Koedu-Token).
N8N_API_TOKEN=

# --- Kebijakan kuota ---
# true = client yang tidak hadir tetap dipotong kuota sesinya.
QUOTA_DEDUCT_ON_ABSENT=false

# --- Data demo (hanya lokal) ---
SEED_USER_PASSWORD=password

# --- AI: pembaca chat jadi draf jadwal ---
# Saklar. AI baru aktif bila ada API key (GEMINI_API_KEYS atau AI_OPENAI_API_KEY).
AI_ENABLED=true
# Draf dibuat hanya bila AI yakin chat itu permintaan jadwal (0 sampai 1).
AI_MIN_CONFIDENCE=0.6
AI_CONTEXT_MESSAGES=8
AI_MAX_CALLS_PER_CONVERSATION_HOUR=20
# Provider cadangan berformat OpenAI (opsional). Tambahkan "openai" di AI_PROVIDERS untuk memakainya, mis. AI_PROVIDERS=gemini,openai
AI_OPENAI_BASE_URL=https://api.openai.com/v1
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini
