      "typeVersion": 4.2,
      "position": [260, 0],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    }
  ],
  "connections": {
    "Tiap malam 02.00": {
      "main": [[{ "node": "Cocokkan Google Sheets di Laravel", "type": "main", "index": 0 }]]
